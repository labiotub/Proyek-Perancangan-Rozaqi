// NOISE THRESHOLD
// < 60 dB       = Good
// 60 - 75 dB    = Getting Too Loud
// > 75 dB       = Too Loud!!!
#define LOW_THRESHOLD 60.0
#define HIGH_THRESHOLD 75.0

// CALIBRATION (MAX4466)
// Kalibrasi satu titik terhadap sound level meter di HP:
// saat suara musik terbaca DB_REF di HP, sensor menghasilkan
// RMS sebesar RMS_REF (satuan hitungan ADC).
// Jika posisi trimmer gain diubah, kalibrasi ulang.
float RMS_REF = 265.0;
float DB_REF  = 65.0;

// Nilai DHT valid terakhir (dipakai jika pembacaan gagal)
float lastTemperature = NAN;
float lastHumidity = NAN;

// FIREBASE TIMING (kirim setiap 3 detik)
unsigned long previousFirebaseMillis = 0;
const unsigned long FIREBASE_INTERVAL = 3000;

// HELPER: bulatkan ke 1 angka di belakang koma
float round1(float value) {
  return roundf(value * 10.0) / 10.0;
}

// HELPER: teks rata tengah di OLED
void drawCentered(String text, int y) {
  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(text, 0, 0, &x1, &y1, &w, &h);
  display.setCursor((SCREEN_WIDTH - w) / 2, y);
  display.println(text);
}

// SETUP
void setup() {
  Serial.begin(115200);

  // LED
  pinMode(LED_GREEN, OUTPUT);
  pinMode(LED_YELLOW, OUTPUT);
  pinMode(LED_RED, OUTPUT);
  digitalWrite(LED_GREEN, LOW);
  digitalWrite(LED_YELLOW, LOW);
  digitalWrite(LED_RED, LOW);

  // ADC ESP32
  analogReadResolution(12);
  analogSetPinAttenuation(SOUND_PIN, ADC_11db);

  // DHT22
  dht.begin();

  // OLED
  Wire.begin(OLED_SDA, OLED_SCL);

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    Serial.println("OLED tidak ditemukan!");
    while (true);
  }

  // TAMPILAN AWAL OLED
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  drawCentered("Smart Noise", 5);
  drawCentered("Monitoring", 18);
  drawCentered("Starting...", 45);
  display.display();
  delay(2000);

  // WIFI CONNECTION
  Serial.println();
  Serial.println("Connecting to WiFi...");
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi connected!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  // FIREBASE CONFIGURATION
  config.api_key = API_KEY;
  config.database_url = DATABASE_URL;

  // Anonymous sign-in
  if (Firebase.signUp(&config, &auth, "", "")) {
    Serial.println("Firebase sign-up anonymous berhasil!");
    signupOK = true;
  } else {
    Serial.print("Sign-up gagal: ");
    Serial.println(config.signer.signupError.message.c_str());
  }

  config.token_status_callback = tokenStatusCallback;

  Firebase.begin(&config, &auth);
  Firebase.reconnectNetwork(true);

  // Kirim angka desimal ke Firebase dengan 1 angka di belakang koma
  Firebase.setFloatDigits(1);

  Serial.println("Firebase initialized!");

  // LOCATION INFORMATION
  Serial.print("Location: ");
  Serial.println(LOCATION);
  Serial.println("System ready!");
}

// READ SOUND LEVEL
float readNoiseLevel() {
  const unsigned long WINDOW_US = 100000;   // jendela pengukuran 100 ms

  double sum = 0;
  double sumSquare = 0;
  unsigned long n = 0;

  unsigned long start = micros();
  while (micros() - start < WINDOW_US) {
    int raw = analogRead(SOUND_PIN);
    sum += raw;
    sumSquare += (double)raw * raw;
    n++;
  }

  double mean = sum / n;

  // RMS sinyal AC = akar dari varians
  double variance = sumSquare / n - mean * mean;
  if (variance < 0) {
    variance = 0;
  }
  float rms = sqrt(variance);

  // Hindari log(0)
  if (rms < 1) {
    rms = 1;
  }

  // Estimasi dB (20 dB per dekade, sesuai sifat mikrofon)
  float dB = DB_REF + 20.0 * log10(rms / RMS_REF);

  return constrain(dB, 30.0, 120.0);
}

// DETERMINE NOISE STATUS
String getStatus(float dB) {
  if (dB < LOW_THRESHOLD) {
    return "Good";
  } else if (dB <= HIGH_THRESHOLD) {
    return "Getting Too Loud";
  } else {
    return "Too Loud!!!";
  }
}

// LED INDICATOR
void updateLED(float dB) {
  digitalWrite(LED_GREEN, LOW);
  digitalWrite(LED_YELLOW, LOW);
  digitalWrite(LED_RED, LOW);

  if (dB < LOW_THRESHOLD) {
    digitalWrite(LED_GREEN, HIGH);
  } else if (dB <= HIGH_THRESHOLD) {
    digitalWrite(LED_YELLOW, HIGH);
  } else {
    digitalWrite(LED_RED, HIGH);
  }
}

// OLED DISPLAY
void updateOLED(float dB, String status, float temperature, float humidity) {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  // TITLE
  display.setTextSize(1);
  drawCentered("Smart Noise", 0);
  drawCentered("Monitoring", 9);

  // dB VALUE
  display.setTextSize(2);
  drawCentered(String(dB, 1) + " dB", 20);

  // STATUS
  display.setTextSize(1);
  drawCentered(status, 39);

  // TEMPERATURE
  display.setCursor(5, 53);
  if (isnan(temperature)) {
    display.print("T: Error");
  } else {
    display.print("T:");
    display.print(temperature, 1);
    display.print("C");
  }

  // HUMIDITY
  display.setCursor(70, 53);
  if (isnan(humidity)) {
    display.print("H: Error");
  } else {
    display.print("H:");
    display.print(humidity, 1);
    display.print("%");
  }

  display.display();
}

// SEND DATA TO FIREBASE
void sendToFirebase(float dB, String status, float temperature, float humidity) {

  // Pastikan sign-up berhasil dan Firebase siap
  if (!signupOK || !Firebase.ready()) {
    Serial.println("Firebase belum siap.");
    return;
  }

  String basePath = "/locations/" + String(LOCATION);

  // SEND NOISE
  if (Firebase.RTDB.setFloat(&fbdo, basePath + "/noise", dB)) {
    Serial.println("Noise berhasil dikirim.");
  } else {
    Serial.print("Noise gagal: ");
    Serial.println(fbdo.errorReason());
  }

  // SEND STATUS
  if (Firebase.RTDB.setString(&fbdo, basePath + "/status", status)) {
    Serial.println("Status berhasil dikirim.");
  } else {
    Serial.print("Status gagal: ");
    Serial.println(fbdo.errorReason());
  }

  // SEND TEMPERATURE
  if (!isnan(temperature)) {
    if (Firebase.RTDB.setFloat(&fbdo, basePath + "/temperature", temperature)) {
      Serial.println("Temperature berhasil dikirim.");
    } else {
      Serial.print("Temperature gagal: ");
      Serial.println(fbdo.errorReason());
    }
  }

  // SEND HUMIDITY
  if (!isnan(humidity)) {
    if (Firebase.RTDB.setFloat(&fbdo, basePath + "/humidity", humidity)) {
      Serial.println("Humidity berhasil dikirim.");
    } else {
      Serial.print("Humidity gagal: ");
      Serial.println(fbdo.errorReason());
    }
  }

  // LOCATION
  Firebase.RTDB.setString(&fbdo, basePath + "/location", LOCATION);

  // TIMESTAMP SEMENTARA
  Firebase.RTDB.setString(&fbdo, basePath + "/last_update", String(millis()));

  Serial.println("Data Firebase selesai dikirim.");
  Serial.println("------------------------------");
}

// MAIN LOOP
void loop() {

  // READ NOISE
  float dB = round1(readNoiseLevel());

  // READ DHT22
  float t = dht.readTemperature();
  float h = dht.readHumidity();

  if (!isnan(t)) lastTemperature = t;
  if (!isnan(h)) lastHumidity = h;

  float temperature = round1(lastTemperature);
  float humidity = round1(lastHumidity);

  // NOISE STATUS
  String status = getStatus(dB);

  // UPDATE LED & OLED
  updateLED(dB);
  updateOLED(dB, status, temperature, humidity);

  // SERIAL MONITOR
  Serial.println("==============================");

  Serial.print("Location    : ");
  Serial.println(LOCATION);

  Serial.print("Noise Level : ");
  Serial.print(dB, 1);
  Serial.println(" dB");

  Serial.print("Status      : ");
  Serial.println(status);

  Serial.print("Temperature : ");
  if (isnan(temperature)) {
    Serial.println("Error");
  } else {
    Serial.print(temperature, 1);
    Serial.println(" C");
  }

  Serial.print("Humidity    : ");
  if (isnan(humidity)) {
    Serial.println("Error");
  } else {
    Serial.print(humidity, 1);
    Serial.println(" %");
  }

  Serial.println("==============================");

  // SEND DATA TO FIREBASE
  if (millis() - previousFirebaseMillis >= FIREBASE_INTERVAL) {
    previousFirebaseMillis = millis();
    sendToFirebase(dB, status, temperature, humidity);
  }

  delay(500);
}
